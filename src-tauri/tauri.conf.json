{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisplayHub Player",
  "version": "0.3.1",
  "identifier": "net.mitchell-group.displayhub.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DisplayHub Player",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "fullscreen": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "DisplayHub digital signage and presentation receiver",
    "longDescription": "Dedicated DisplayHub player for managed signage screens and local presentation receiving.",
    "resources": {
      "resources/airplay/": "airplay/"
    }
  }
}
